// ============================================================================
//  pacbio-hifi-wgs : Nextflow DSL2 pipeline for LongPlex PacBio HiFi
//  bacterial whole-genome assembly, QC and annotation.
// ============================================================================

nextflow.enable.dsl = 2

params {
    // --- I/O ---
    input                = null                 // REQUIRED: samplesheet CSV (sample,fastq[,illumina_1,illumina_2])
    outdir               = "./results" // overriden by sbatch script

    // --- genome / coverage ---
    genome_size          = "5m"                 // string for Flye (-g)
    expected_genome_size = 5000000              // integer, used only for the coverage estimate
    min_coverage_warn    = 20                   // flag samples below this HiFi depth
    max_contigs          = 20        // PASS requires fewer contigs than this
    
    // --- toggles ---
    skip_filter          = true                 // HiFi reads are already ccs/pbtrim-clean; filtering is optional
    run_flye             = true                 // run Flye --pacbio-hifi as an independent cross-check of hifiasm

    // --- reference databases (MUST point at local copies; GL compute nodes are offline) ---
    skani_db             = "/nfs/turbo/umms-esnitkin/database/skani/gtdb_skani_database_ani"
    // bakta_db             = "/scratch/esnitkin_root/esnitkin1/dhatrib/nanoQC/db"
    // busco_db             = "/nfs/turbo/umms-esnitkin/database/busco"      // <-- set to your BUSCO download_path
    // busco_lineage        = "bacteria_odb10"
    // checkm2_db           = "/nfs/turbo/umms-esnitkin/database/checkm2/uniref100.KO.1.dmnd"  // <-- set

    // --- tool args ---
    // bakta_args           = "--keep-contig-headers"

    // --- cluster / executor ---
    account              = "esnitkin2"          // <-- your SLURM allocation (your submit script used esnitkin2)
    partition            = "standard"
    queue_size           = 100                   // mirrors snakemake -j 100 aka how many run at once 

}

includeConfig 'conf/base.config'

profiles {
    slurm {
        process.executor      = 'slurm'
        process.clusterOptions = "--account=${params.account} --partition=${params.partition}"
        executor.queueSize    = params.queue_size
        executor.submitRateLimit = '30/1min' // caps submission rate, not concurrency i.e. queue_size
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.runOptions = '-B /nfs/turbo/umms-esnitkin'
    }
    test { params.input = "${projectDir}/assets/samplesheet.csv" }
}

// execution reports (written to <outdir>/pipeline_info)
def trace_ts = new java.util.Date().format('yyyyMMdd_HHmmss')
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${trace_ts}.html" }
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${trace_ts}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${trace_ts}.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag_${trace_ts}.html" }

manifest {
    name            = 'pacbio-hifi-wgs'
    author          = 'Dhatri Badri'
    description     = 'LongPlex PacBio HiFi bacterial WGS: QC -> assembly -> assembly QC -> annotation'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}
